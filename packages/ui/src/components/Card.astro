---
/**
 * Card — a surface for grouping related content (a service, a pricing tier,
 * a feature). Provides consistent padding, border/shadow and radius; layout
 * and content inside are left to the caller (compose with Heading, Text,
 * Badge, Button, etc.).
 */
export interface Props {
  /** Element tag to render. Use "article" for a self-contained piece of
   * content, "li" when rendering a list of cards. Defaults to "div". */
  as?: "div" | "article" | "li";
  /** Inner spacing. Defaults to "md". */
  padding?: "sm" | "md" | "lg";
  /** Surface treatment. Defaults to "outlined". */
  variant?: "flat" | "outlined" | "elevated";
  /** Adds a hover affordance (border + slight lift) for a card that acts as
   * one hoverable/clickable unit. Leave off for cards with no per-card
   * destination, where a hover reaction would be a false affordance.
   * Defaults to false. */
  interactive?: boolean;
  /** Additional class names to merge onto the root element. */
  class?: string;
  /** Any other attribute (e.g. `data-*`, `aria-*`) passes through to the root element. */
  [key: `data-${string}`]: unknown;
}

const { as: Tag = "div", padding = "md", variant = "outlined", interactive = false, class: className, ...rest } = Astro.props;
---

<Tag
  class:list={["ui-card", `ui-card--${variant}`, `ui-card--pad-${padding}`, { "ui-card--interactive": interactive }, className]}
  {...rest}
>
  <slot />
</Tag>

<style>
  .ui-card {
    background-color: var(--ui-color-bg, #ffffff);
    border-radius: var(--ui-radius-lg, 0.75rem);
    border: 1px solid transparent;
  }

  .ui-card--pad-sm {
    padding: 1rem;
  }

  .ui-card--pad-md {
    padding: 1.5rem;
  }

  .ui-card--pad-lg {
    padding: 2rem;
  }

  .ui-card--flat {
    border-color: transparent;
  }

  .ui-card--outlined {
    border-color: var(--ui-color-border, #e5e7eb);
  }

  .ui-card--elevated {
    border-color: var(--ui-color-border, #e5e7eb);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.04),
      0 8px 24px rgba(0, 0, 0, 0.06);
  }

  .ui-card--interactive {
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ui-card--interactive {
      transition:
        border-color 0.15s ease,
        box-shadow 0.15s ease,
        transform 0.15s ease;
    }

    .ui-card--interactive:hover {
      transform: translateY(-2px);
    }
  }

  .ui-card--interactive:hover {
    box-shadow: 0 8px 20px -8px color-mix(in srgb, var(--ui-color-fg, #111827) 18%, transparent);
  }

  /* Border-color shift only for "outlined", whose border is visible on all
     sides by design. "flat" cards may deliberately show a border on only
     one side (e.g. Testimonials' top rule) — shifting `border-color` there
     would paint in the sides they left transparent on purpose. */
  .ui-card--outlined.ui-card--interactive:hover {
    border-color: var(--ui-color-primary, #2563eb);
  }
</style>
