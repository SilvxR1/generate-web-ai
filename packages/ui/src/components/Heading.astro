---
/**
 * Heading — a semantic heading (h1-h6) with a visual size chosen
 * independently of that level. Keeps document outline/SEO correct (one h1
 * per page, no skipped levels) while letting a design pick, say, an h2 that
 * reads visually smaller than the hero's h1.
 */
export interface Props {
  /** Semantic heading level — required, always maps to the matching h1-h6 tag. */
  level: 1 | 2 | 3 | 4 | 5 | 6;
  /** Visual size. Defaults to a sensible size for `level` if omitted. */
  size?: "sm" | "md" | "lg" | "xl" | "2xl" | "3xl";
  /**
   * Typeface voice. "display" reads `--ui-font-display` (falling back to
   * `--ui-font-sans` if a theme doesn't define one) for editorial/statement
   * headings — a hero H1, a section's lead H2. "sans" (default) is the
   * everyday interface voice used for card/item headings. Themes with no
   * display font configured render identically either way.
   */
  font?: "sans" | "display";
  /** Additional class names to merge onto the root element. */
  class?: string;
}

const defaultSizeByLevel: Record<Props["level"], NonNullable<Props["size"]>> = {
  1: "3xl",
  2: "2xl",
  3: "xl",
  4: "lg",
  5: "md",
  6: "sm",
};

const { level, size, font = "sans", class: className } = Astro.props;
const Tag = `h${level}` as "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
const resolvedSize = size ?? defaultSizeByLevel[level];
---

<Tag class:list={["ui-heading", `ui-heading--${resolvedSize}`, `ui-heading--font-${font}`, className]}>
  <slot />
</Tag>

<style>
  .ui-heading {
    font-family: var(--ui-font-sans, ui-sans-serif, system-ui, sans-serif);
    color: var(--ui-color-fg, #111827);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .ui-heading--font-display {
    font-family: var(--ui-font-display, var(--ui-font-sans, ui-sans-serif, system-ui, sans-serif));
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  /* Fluid scale: readable at 375px, reaches full size only on wide viewports. */
  .ui-heading--sm {
    font-size: clamp(1.0625rem, 0.97rem + 0.4vw, 1.1875rem);
  }

  .ui-heading--md {
    font-size: clamp(1.1875rem, 1.05rem + 0.65vw, 1.4375rem);
  }

  .ui-heading--lg {
    font-size: clamp(1.375rem, 1.15rem + 1.1vw, 1.8125rem);
  }

  .ui-heading--xl {
    font-size: clamp(1.625rem, 1.3rem + 1.6vw, 2.3125rem);
  }

  .ui-heading--2xl {
    font-size: clamp(1.875rem, 1.4rem + 2.4vw, 2.75rem);
  }

  .ui-heading--3xl {
    font-size: clamp(2.25rem, 1.5rem + 3.75vw, 4.25rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .ui-heading--font-display.ui-heading--3xl,
  .ui-heading--font-display.ui-heading--2xl {
    letter-spacing: -0.015em;
  }
</style>
