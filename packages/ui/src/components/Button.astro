---
/**
 * Button — the primary interactive action element (call-to-action, form
 * submit, in-page action). Renders a native `<button>`, or a native `<a>`
 * when `href` is provided, so it can serve as a link styled like a button
 * without losing correct semantics/keyboard behavior for either case.
 */
export interface Props {
  /** Visual weight. Defaults to "solid". */
  variant?: "solid" | "outline" | "ghost";
  /** Size scale. Defaults to "md". */
  size?: "sm" | "md" | "lg";
  /** When set, renders an `<a>` instead of a `<button>`. */
  href?: string;
  /** Native button `type`. Ignored when `href` is set. Defaults to "button". */
  type?: "button" | "submit" | "reset";
  /** Disables the control (native `disabled` for buttons, `aria-disabled` for links). */
  disabled?: boolean;
  /** Anchor `target`. Only applies when `href` is set. */
  target?: "_blank" | "_self" | "_parent" | "_top";
  /** Anchor `rel`. Only applies when `href` is set. Auto-set for `target="_blank"` if omitted. */
  rel?: string;
  /** Additional class names to merge onto the root element. */
  class?: string;
  "aria-label"?: string;
}

const {
  variant = "solid",
  size = "md",
  href,
  type = "button",
  disabled = false,
  target,
  rel,
  class: className,
  "aria-label": ariaLabel,
} = Astro.props;

const Tag = href ? "a" : "button";
const computedRel = target === "_blank" ? (rel ?? "noopener noreferrer") : rel;
---

<Tag
  class:list={[
    "ui-btn",
    `ui-btn--${variant}`,
    `ui-btn--${size}`,
    { "ui-btn--disabled": disabled },
    className,
  ]}
  href={href}
  type={href ? undefined : type}
  target={href ? target : undefined}
  rel={href ? computedRel : undefined}
  disabled={href ? undefined : disabled}
  aria-disabled={href && disabled ? "true" : undefined}
  tabindex={href && disabled ? -1 : undefined}
  aria-label={ariaLabel}
>
  <slot />
</Tag>

<style>
  .ui-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    font-family: var(--ui-font-sans, ui-sans-serif, system-ui, sans-serif);
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    border-radius: var(--ui-radius, 0.5rem);
    border: 1px solid transparent;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease,
      opacity 0.15s ease;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ui-btn {
      transition:
        background-color 0.15s ease,
        border-color 0.15s ease,
        color 0.15s ease,
        opacity 0.15s ease,
        transform 0.15s ease,
        box-shadow 0.15s ease;
    }

    .ui-btn:hover {
      transform: translateY(-1px);
    }

    .ui-btn--solid:hover {
      box-shadow: 0 6px 16px -4px color-mix(in srgb, var(--ui-color-primary, #2563eb) 45%, transparent);
    }

    .ui-btn:active {
      transform: translateY(0) scale(0.98);
    }
  }

  .ui-btn:focus-visible {
    outline: 2px solid var(--ui-color-primary, #2563eb);
    outline-offset: 2px;
  }

  /* Padded up from an earlier 0.375rem vertical (~31px tall) toward the
     44px touch-target guideline. Can't close the rest of the gap without
     regressing the size ladder: matching 44px outright needs ~0.85rem
     vertical padding, which would make "sm" as tall as "md" (~41px) and
     erase the distinction between the two tiers. This still clears WCAG
     2.5.8's AA minimum (24x24) with room to spare; 44px AAA stays
     unreachable for the smallest tier by design. */
  .ui-btn--sm {
    padding: 0.5rem 0.875rem;
    font-size: 0.875rem;
  }

  .ui-btn--md {
    padding: 0.625rem 1.25rem;
    font-size: 1rem;
  }

  .ui-btn--lg {
    padding: 0.875rem 1.75rem;
    font-size: 1.125rem;
  }

  .ui-btn--solid {
    background-color: var(--ui-color-primary, #2563eb);
    color: var(--ui-color-primary-fg, #ffffff);
  }

  .ui-btn--solid:hover {
    filter: brightness(0.92);
  }

  .ui-btn--outline {
    background-color: transparent;
    border-color: var(--ui-color-primary, #2563eb);
    color: var(--ui-color-primary, #2563eb);
  }

  .ui-btn--outline:hover {
    background-color: color-mix(in srgb, var(--ui-color-primary, #2563eb) 10%, transparent);
  }

  .ui-btn--ghost {
    background-color: transparent;
    border-color: transparent;
    color: var(--ui-color-primary, #2563eb);
  }

  .ui-btn--ghost:hover {
    background-color: color-mix(in srgb, var(--ui-color-primary, #2563eb) 10%, transparent);
  }

  .ui-btn--disabled,
  .ui-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }
</style>
