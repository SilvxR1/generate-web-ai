---
/**
 * Container — centers content horizontally and applies consistent side
 * gutters and a max-width. The layout primitive every page section wraps
 * itself in, so content width stays consistent across a site without each
 * block reimplementing its own width/padding rules.
 */
export interface Props {
  /** Element tag to render. Defaults to "div". */
  as?: "div" | "section" | "header" | "footer" | "main" | "article";
  /** Max-width scale. Defaults to "lg". */
  size?: "sm" | "md" | "lg" | "xl" | "full";
  /** Additional class names to merge onto the root element. */
  class?: string;
}

const { as: Tag = "div", size = "lg", class: className } = Astro.props;
---

<Tag class:list={["ui-container", `ui-container--${size}`, className]}>
  <slot />
</Tag>

<style>
  .ui-container {
    width: 100%;
    margin-inline: auto;
    padding-inline: 1rem;
  }

  .ui-container--sm {
    max-width: 40rem;
  }

  .ui-container--md {
    max-width: 56rem;
  }

  .ui-container--lg {
    max-width: 72rem;
  }

  .ui-container--xl {
    max-width: 88rem;
  }

  .ui-container--full {
    max-width: none;
  }

  @media (min-width: 640px) {
    .ui-container {
      padding-inline: 1.5rem;
    }
  }
</style>
