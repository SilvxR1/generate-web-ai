---
/**
 * Hero — the top-of-page banner: a headline, optional supporting copy,
 * up to two calls to action, an optional image, and an optional highlighted
 * stat overlaid on that image. Business-agnostic: every word, image, and
 * figure comes in through `content`; nothing here assumes a renovation
 * business specifically.
 */
import { Button, Container, Heading, Media, Text } from "@generate-web-ai/ui";
import type { BlockAction, BlockImage } from "../types";

export interface HeroStat {
  value: string;
  label: string;
}

export interface HeroContent {
  /** Small label above the heading (e.g. a category or tagline). */
  eyebrow?: string;
  /** Main headline. Rendered as the page's `<h1>`. */
  heading: string;
  /** Supporting copy under the heading. */
  subheading?: string;
  primaryAction?: BlockAction;
  secondaryAction?: BlockAction;
  image?: BlockImage;
  /** Optional highlighted figure overlaid on the image (e.g. "+10 años" / "de experiencia"). */
  stat?: HeroStat;
}

export interface Props {
  content: HeroContent;
  /** Anchor id for in-page navigation. */
  id?: string;
  /** Section surface tone. Defaults to "base". */
  background?: "base" | "surface";
  /** Animates the section into view on scroll. Unlike every other block,
   * this defaults to `false`: the Hero is normally the first thing on the
   * page — already visible without scrolling — so animating it in on load
   * has nothing to do with "scroll" and risks a flash of hidden content
   * right where a visitor's eye lands first. Scroll-reveal is meant to be
   * felt starting from the section after this one. */
  reveal?: boolean;
  class?: string;
}

const { content, id, background = "base", reveal = false, class: className } = Astro.props;
const { eyebrow, heading, subheading, primaryAction, secondaryAction, image, stat } = content;
---

<section id={id} data-surface={background} class:list={["block-hero", { "block-reveal": reveal }, className]}>
  <Container size="xl">
    <div class="block-hero__layout" data-has-image={image ? "true" : "false"}>
      <div class="block-hero__copy">
        {eyebrow && (
          <p class="block-hero__eyebrow">
            <span class="block-hero__eyebrow-rule" aria-hidden="true"></span>
            {eyebrow}
          </p>
        )}
        <Heading level={1} font="display">{heading}</Heading>
        {subheading && (
          <Text size="lg" variant="muted" class="block-hero__subheading">
            {subheading}
          </Text>
        )}
        {(primaryAction || secondaryAction) && (
          <div class="block-hero__actions">
            {primaryAction && (
              <Button href={primaryAction.href} variant={primaryAction.variant ?? "solid"} size="lg">
                {primaryAction.label}
              </Button>
            )}
            {secondaryAction && (
              <Button href={secondaryAction.href} variant={secondaryAction.variant ?? "outline"} size="lg">
                {secondaryAction.label}
              </Button>
            )}
          </div>
        )}
      </div>
      {image && (
        <div class="block-hero__media">
          <div class="block-hero__frame">
            <Media src={image.src} alt={image.alt} width={image.width} height={image.height} ratio="4/5" radius="sm" loading="eager" />
          </div>
          {stat && (
            <div class="block-hero__stat">
              <p class="block-hero__stat-value">{stat.value}</p>
              <p class="block-hero__stat-label">{stat.label}</p>
            </div>
          )}
        </div>
      )}
    </div>
  </Container>
</section>

<style>
  .block-hero {
    padding-block: var(--ui-space-section-lg, clamp(3rem, 3rem + 4vw, 6rem)) clamp(3rem, 3rem + 3vw, 5rem);
    background-color: var(--ui-color-bg, #ffffff);
  }

  .block-hero[data-surface="surface"] {
    background-color: var(--ui-color-surface-alt, var(--ui-color-bg, #ffffff));
  }

  .block-hero__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .block-hero__copy {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 34rem;
  }

  .block-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    font-family: var(--ui-font-sans, ui-sans-serif, system-ui, sans-serif);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ui-color-primary, #2563eb);
  }

  .block-hero__eyebrow-rule {
    display: inline-block;
    width: 2rem;
    height: 2px;
    background-color: var(--ui-color-primary, #2563eb);
  }

  .block-hero__subheading {
    max-width: 32rem;
  }

  .block-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 0.5rem;
  }

  .block-hero__media {
    position: relative;
  }

  .block-hero__frame {
    position: relative;
  }

  /* An offset panel behind the photo for depth/layering, using only the
     existing accent color — no new imagery or gradients. */
  .block-hero__frame::before {
    content: "";
    position: absolute;
    inset: 1rem -1rem -1rem 1rem;
    background-color: color-mix(in srgb, var(--ui-color-primary, #2563eb) 16%, transparent);
    border-radius: var(--ui-radius, 0.5rem);
    z-index: -1;
  }

  .block-hero__stat {
    position: static;
    margin-top: 1rem;
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.125rem;
    padding: 0.875rem 1.125rem;
    background-color: var(--ui-color-bg, #ffffff);
    border: 1px solid var(--ui-color-border, #e5e7eb);
    border-radius: var(--ui-radius, 0.5rem);
    box-shadow: 4px 4px 0 color-mix(in srgb, var(--ui-color-fg, #111827) 8%, transparent);
    color: var(--ui-color-fg, #111827);
  }

  .block-hero__stat-value {
    margin: 0;
    font-family: var(--ui-font-display, var(--ui-font-sans, ui-sans-serif, system-ui, sans-serif));
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1.1;
  }

  .block-hero__stat-label {
    margin: 0;
    font-family: var(--ui-font-sans, ui-sans-serif, system-ui, sans-serif);
    font-size: 0.75rem;
    color: var(--ui-color-muted-fg, #6b7280);
  }

  @media (min-width: 640px) {
    .block-hero__frame {
      max-width: 26rem;
      margin-inline: auto;
    }
  }

  @media (min-width: 900px) {
    .block-hero__layout[data-has-image="true"] {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
      gap: 3.5rem;
    }

    .block-hero__copy {
      max-width: none;
    }

    .block-hero__frame {
      max-width: none;
      margin-inline: 0;
    }

    .block-hero__stat {
      position: absolute;
      bottom: -1.5rem;
      left: -1.5rem;
      margin-top: 0;
    }
  }
</style>
