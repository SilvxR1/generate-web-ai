---
/**
 * FAQ — a list of question/answer pairs rendered as native disclosure
 * widgets (`<details>`/`<summary>`), which are keyboard- and
 * screen-reader-accessible without any client-side JavaScript.
 */
import { Container, Heading, Text } from "@generate-web-ai/ui";

export interface FAQItem {
  question: string;
  answer: string;
}

export interface FAQContent {
  heading?: string;
  subheading?: string;
  items: FAQItem[];
}

export interface Props {
  content: FAQContent;
  id?: string;
  /** Section surface tone. Defaults to "base". */
  background?: "base" | "surface";
  /** Animates the section into view on scroll. Defaults to true; has no
   * effect when the visitor prefers reduced motion or JS doesn't run. */
  reveal?: boolean;
  class?: string;
}

const { content, id, background = "base", reveal = true, class: className } = Astro.props;
const { heading, subheading, items } = content;
---

<section id={id} data-surface={background} class:list={["block-faq", { "block-reveal": reveal }, className]}>
  <Container size="md">
  {(heading || subheading) && (
    <div class="block-faq__intro">
      {heading && <Heading level={2} font="display">{heading}</Heading>}
      {subheading && (
        <Text size="lg" variant="muted">
          {subheading}
        </Text>
      )}
    </div>
  )}
  <div class="block-faq__list">
    {items.map((item) => (
      <details class="block-faq__item">
        <summary class="block-faq__question">{item.question}</summary>
        <div class="block-faq__answer">
          <Text as="div" variant="muted" class="block-faq__answer-text">
            {item.answer}
          </Text>
        </div>
      </details>
    ))}
  </div>
  </Container>
</section>

<style>
  .block-faq {
    padding-block: var(--ui-space-section-sm, clamp(3rem, 2.6rem + 1.6vw, 4rem));
    background-color: var(--ui-color-bg, #ffffff);
  }

  .block-faq[data-surface="surface"] {
    background-color: var(--ui-color-surface-alt, var(--ui-color-bg, #ffffff));
  }

  .block-faq__intro {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .block-faq__list {
    display: flex;
    flex-direction: column;
  }

  .block-faq__item {
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--ui-color-border, #e5e7eb);
  }

  .block-faq__item:first-child {
    border-top: 1px solid var(--ui-color-border, #e5e7eb);
  }

  .block-faq__question {
    cursor: pointer;
    font-family: var(--ui-font-sans, ui-sans-serif, system-ui, sans-serif);
    font-weight: 600;
    color: var(--ui-color-fg, #111827);
    list-style: none;
  }

  .block-faq__question::-webkit-details-marker {
    display: none;
  }

  .block-faq__question::before {
    content: "+";
    display: inline-block;
    width: 1em;
    margin-right: 0.5rem;
  }

  details[open] > .block-faq__question::before {
    content: "\2212";
  }

  .block-faq__question:focus-visible {
    outline: 2px solid var(--ui-color-primary, #2563eb);
    outline-offset: 2px;
  }

  /* Grid-rows trick: animates from a 0-height row to its content's natural
     height, which a plain `height`/`max-height` transition can't do without
     a fixed target height. Relies on `<details>` content no longer being
     hard `display: none` when closed in current browsers (only hidden via
     the UA stylesheet's rendering, not removed from layout) — this is what
     makes it possible to sit an actual box on this element even while
     closed. Older browsers without transition support here just snap
     open/closed, same as before this change. */
  .block-faq__answer {
    display: grid;
    grid-template-rows: 0fr;
  }

  @media (prefers-reduced-motion: no-preference) {
    .block-faq__answer {
      transition: grid-template-rows 0.25s cubic-bezier(0.77, 0, 0.175, 1);
    }
  }

  details[open] > .block-faq__answer {
    grid-template-rows: 1fr;
  }

  .block-faq__answer-text {
    overflow: hidden;
    padding-top: 0.75rem;
  }
</style>
