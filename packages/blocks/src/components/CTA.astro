---
/**
 * CTA — a focused call-to-action banner, typically used to close a page.
 * "emphasis" renders a full-bleed, high-contrast panel for a genuine
 * conversion moment; "default" (the prior appearance) is a lighter inline
 * panel for a secondary CTA elsewhere on the page.
 */
import { Button, Container, Heading, Text } from "@generate-web-ai/ui";
import type { BlockAction } from "../types";

export interface CTAContent {
  heading: string;
  subheading?: string;
  primaryAction: BlockAction;
  secondaryAction?: BlockAction;
  /** "emphasis" renders a full-bleed, high-contrast panel. Defaults to "default". */
  variant?: "default" | "emphasis";
}

export interface Props {
  content: CTAContent;
  id?: string;
  /** Animates the section into view on scroll. Defaults to true; has no
   * effect when the visitor prefers reduced motion or JS doesn't run. */
  reveal?: boolean;
  class?: string;
}

const { content, id, reveal = true, class: className } = Astro.props;
const { heading, subheading, primaryAction, secondaryAction, variant = "default" } = content;
---

<section id={id} data-variant={variant} class:list={["block-cta", { "block-reveal": reveal }, className]}>
  <Container size={variant === "emphasis" ? "lg" : "md"}>
  <div class="block-cta__panel">
    <Heading level={2} font="display" class="block-cta__heading">{heading}</Heading>
    {subheading && (
      <Text size="lg" variant="muted" class="block-cta__subheading">
        {subheading}
      </Text>
    )}
    <div class="block-cta__actions">
      <Button href={primaryAction.href} variant={primaryAction.variant ?? "solid"} size="lg">
        {primaryAction.label}
      </Button>
      {secondaryAction && (
        <Button href={secondaryAction.href} variant={secondaryAction.variant ?? "outline"} size="lg">
          {secondaryAction.label}
        </Button>
      )}
    </div>
  </div>
  </Container>
</section>

<style>
  .block-cta {
    padding-block: var(--ui-space-section-md, clamp(3.5rem, 3rem + 2.5vw, 5.5rem));
  }

  .block-cta__panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  .block-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 0.5rem;
  }

  /* Default: a light inline panel, for a secondary CTA moment. */
  .block-cta[data-variant="default"] .block-cta__panel {
    padding: 2.5rem 1.5rem;
    border-radius: var(--ui-radius-lg, 0.75rem);
    background-color: var(--ui-color-surface-alt, var(--ui-color-bg, #ffffff));
    border: 1px solid var(--ui-color-border, #e5e7eb);
  }

  /* Emphasis: a full-bleed, high-contrast panel — the page's strongest
     conversion moment. */
  .block-cta[data-variant="emphasis"] {
    background-color: var(--ui-color-fg, #111827);
  }

  .block-cta[data-variant="emphasis"] .block-cta__panel {
    padding-block: 1rem;
  }

  .block-cta[data-variant="emphasis"] :global(.ui-heading) {
    color: #ffffff;
  }

  .block-cta[data-variant="emphasis"] .block-cta__subheading {
    color: color-mix(in srgb, #ffffff 70%, transparent);
  }

  /* The outline/ghost Button variants use --ui-color-primary for
     border/text, tuned for light backgrounds — against this panel's dark
     fill that combination doesn't reach AA contrast, so it's overridden
     to white here specifically. */
  .block-cta[data-variant="emphasis"] :global(.ui-btn--outline),
  .block-cta[data-variant="emphasis"] :global(.ui-btn--ghost) {
    border-color: color-mix(in srgb, #ffffff 55%, transparent);
    color: #ffffff;
  }

  .block-cta[data-variant="emphasis"] :global(.ui-btn--outline:hover),
  .block-cta[data-variant="emphasis"] :global(.ui-btn--ghost:hover) {
    background-color: color-mix(in srgb, #ffffff 12%, transparent);
    border-color: #ffffff;
  }

  @media (min-width: 768px) {
    .block-cta[data-variant="default"] .block-cta__panel {
      padding: 3.5rem 3rem;
    }

    .block-cta[data-variant="emphasis"] .block-cta__panel {
      padding-block: 1.5rem;
    }
  }
</style>
