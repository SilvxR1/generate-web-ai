---
/**
 * Contact — business contact details plus an optional native contact form,
 * composed as two panels on wide viewports (info + form) and stacked on
 * narrow ones. The form renders accessible fields and submits via standard
 * HTML `action`/`method` when one is configured — wiring a real endpoint
 * stays a site/app concern, not this block's. When no `action` is set (no
 * backend wired up yet), the script below prevents the pointless
 * same-page reload and instead dispatches a neutral `lead.submitted`
 * DOM CustomEvent carrying the submitted field values, so a future
 * site/app-level integration (analytics, eventually a CRM/n8n bridge)
 * has something to listen for without this block knowing anything about
 * where leads should go.
 *
 * Fields flow two-up on desktop automatically by field *type* — textarea,
 * file, and grouped radio/checkbox fields span the full row; short
 * text/email/tel/select fields pair up. This is content-shape-driven, not
 * tied to any particular field's name, so it stays generic across clients.
 */
import { Button, Container, Heading, Link, Text } from "@generate-web-ai/ui";

export interface ContactDetail {
  /** e.g. "Phone", "Email", "Address". */
  label: string;
  value: string;
  /** e.g. "tel:+1..." or "mailto:...". Renders the value as a link when set. */
  href?: string;
}

/** A prominent WhatsApp CTA button in the info panel, distinct from a
 * plain WhatsApp `ContactDetail` row — see @generate-web-ai/site-config's
 * ContactWhatsAppCtaConfig, which this mirrors field-for-field. Clicks on
 * this (and on any tel:/mailto:/wa.me link anywhere on the page) are
 * tracked by apps/site-builder's site-wide analytics script, inferred
 * purely from each link's `href` scheme — no `data-*` attribute needed
 * here (see that script's own docstring). */
export interface ContactWhatsAppCta {
  href: string;
  label: string;
}

export interface ContactFormFieldOption {
  label: string;
  value: string;
}

interface ContactFormFieldBase {
  name: string;
  label: string;
  required?: boolean;
  placeholder?: string;
}

export interface TextContactFormField extends ContactFormFieldBase {
  type?: "text" | "email" | "tel" | "textarea";
}

export interface SelectContactFormField extends ContactFormFieldBase {
  type: "select";
  options: ContactFormFieldOption[];
}

export interface RadioContactFormField extends ContactFormFieldBase {
  type: "radio";
  options: ContactFormFieldOption[];
}

/**
 * No `options` renders a single toggle; `options` renders a checkbox group.
 * `required` on a single toggle maps to the native `required` attribute
 * (that one box must be checked). On a group it means "at least one of
 * these must be checked" — HTML has no native attribute for that (unlike
 * `required` on a radio group, which the browser already treats as "one of
 * this group"), so it's enforced by the small inline script below instead.
 */
export interface CheckboxContactFormField extends ContactFormFieldBase {
  type: "checkbox";
  options?: ContactFormFieldOption[];
}

/** Presentational only — no upload wiring. Submission handling is a site/app concern. */
export interface FileContactFormField extends ContactFormFieldBase {
  type: "file";
  accept?: string;
  multiple?: boolean;
}

export type ContactFormField =
  | TextContactFormField
  | SelectContactFormField
  | RadioContactFormField
  | CheckboxContactFormField
  | FileContactFormField;

export interface ContactForm {
  action?: string;
  method?: "get" | "post";
  fields: ContactFormField[];
  submitLabel?: string;
}

export interface ContactContent {
  heading?: string;
  subheading?: string;
  details?: ContactDetail[];
  form?: ContactForm;
  whatsappCta?: ContactWhatsAppCta;
}

export interface Props {
  content: ContactContent;
  id?: string;
  /** Section surface tone. Defaults to "base". */
  background?: "base" | "surface";
  /** Animates the section into view on scroll. Defaults to true; has no
   * effect when the visitor prefers reduced motion or JS doesn't run. */
  reveal?: boolean;
  class?: string;
}

const { content, id, background = "base", reveal = true, class: className } = Astro.props;
const { heading, subheading, details, form, whatsappCta } = content;
const formIdPrefix = id ?? "contact";

// Full-width field types (their content doesn't suit a half-width column);
// everything else pairs up two-per-row automatically via CSS grid.
const FULL_WIDTH_TYPES = new Set(["textarea", "file"]);
---

<section id={id} data-surface={background} class:list={["block-contact", { "block-reveal": reveal }, className]}>
  <Container size="lg">
  <div class="block-contact__panels">
    <div class="block-contact__info">
      {(heading || subheading) && (
        <div class="block-contact__intro">
          {heading && <Heading level={2} font="display">{heading}</Heading>}
          {subheading && (
            <Text size="lg" variant="muted">
              {subheading}
            </Text>
          )}
        </div>
      )}
      {details && details.length > 0 && (
        <dl class="block-contact__details">
          {details.map((detail) => (
            <div class="block-contact__detail">
              <dt>
                <Text as="span" size="sm" variant="muted">
                  {detail.label}
                </Text>
              </dt>
              <dd>
                {detail.href ? (
                  <Link href={detail.href}>{detail.value}</Link>
                ) : (
                  <Text as="span">{detail.value}</Text>
                )}
              </dd>
            </div>
          ))}
        </dl>
      )}
      {whatsappCta && (
        <Button href={whatsappCta.href} variant="solid">
          {whatsappCta.label}
        </Button>
      )}
    </div>

    {form && (
      <form class="block-contact__form" action={form.action} method={form.method ?? "post"}>
        <div class="block-contact__fields">
        {form.fields.map((field) => {
          const fieldId = `${formIdPrefix}-${field.name}`;
          const isFullWidth = FULL_WIDTH_TYPES.has(field.type ?? "text") || field.type === "radio" || field.type === "checkbox";

          const groupOptions: ContactFormFieldOption[] | undefined =
            field.type === "radio" ? field.options : field.type === "checkbox" ? field.options : undefined;

          if (groupOptions) {
            const inputType = field.type === "radio" ? "radio" : "checkbox";
            const isRequired = field.required;
            // Checkboxes in a group share one field name but each submits its own
            // value — without `[]` a plain form-urlencoded/FormData POST (this
            // block's only submission path; see file header) keeps just one of
            // the checked values, silently dropping the rest. Radio groups don't
            // need this: only one radio in the group is ever checked/submitted.
            const groupName = inputType === "checkbox" ? `${field.name}[]` : field.name;
            return (
              <fieldset
                class="block-contact__field block-contact__fieldset"
                data-span={isFullWidth ? "full" : undefined}
                data-checkbox-group-required={inputType === "checkbox" && isRequired ? "true" : undefined}
              >
                <legend>{field.label}</legend>
                <div class="block-contact__option-group">
                  {groupOptions.map((option) => (
                    <label class="block-contact__option">
                      <input
                        type={inputType}
                        name={groupName}
                        value={option.value}
                        required={inputType === "radio" ? isRequired : undefined}
                      />
                      <span>{option.label}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            );
          }

          return (
            <div class="block-contact__field" data-span={isFullWidth ? "full" : undefined}>
              <label for={fieldId}>{field.label}</label>
              {field.type === "textarea" ? (
                <textarea
                  id={fieldId}
                  name={field.name}
                  required={field.required}
                  placeholder={field.placeholder}
                  rows={5}
                />
              ) : field.type === "select" ? (
                <select id={fieldId} name={field.name} required={field.required}>
                  {field.options.map((option) => (
                    <option value={option.value}>{option.label}</option>
                  ))}
                </select>
              ) : field.type === "checkbox" ? (
                <label class="block-contact__option">
                  <input id={fieldId} type="checkbox" name={field.name} required={field.required} />
                  <span>{field.placeholder ?? field.label}</span>
                </label>
              ) : field.type === "file" ? (
                <input
                  id={fieldId}
                  type="file"
                  name={field.name}
                  accept={field.accept}
                  multiple={field.multiple}
                  required={field.required}
                />
              ) : (
                <input
                  id={fieldId}
                  name={field.name}
                  type={field.type ?? "text"}
                  required={field.required}
                  placeholder={field.placeholder}
                />
              )}
            </div>
          );
        })}
        </div>
        {
          /**
           * Anti-spam fields (P1 Part B) — transport/spam-boundary
           * concerns of this specific submission path, not business
           * content, so they're never part of `form.fields`
           * (ContactFormConfig, @generate-web-ai/site-config).
           *
           * Honeypot: a real visitor — sighted or using assistive tech —
           * never interacts with this field, so it's hidden from *both*
           * (aria-hidden + tabindex="-1" removes it from every
           * accessibility tree and the tab order; autocomplete="off" and
           * a name unrelated to any real autofill category keep a
           * browser from filling it in on a real visitor's behalf). It's
           * a plain visible `<input type="text">` under the hood —
           * `type="hidden"` is deliberately avoided, since some bots
           * skip hidden inputs entirely, which would defeat the whole
           * point. Positioned off-screen via CSS rather than
           * `display:none`/`visibility:hidden`, for the same reason.
           * The backend (app.leads.spam.is_spam) treats any non-empty
           * value here as spam.
           */
        }
        <input
          type="text"
          name="hp_field"
          class="block-contact__honeypot"
          tabindex={-1}
          autocomplete="off"
          aria-hidden="true"
        />
        {
          /**
           * Submission timing: populated client-side (see the script
           * below) with the timestamp this form was actually rendered —
           * the backend (app.leads.spam.is_spam) treats a submission
           * arriving less than ~2s after this moment as spam (faster
           * than a human can plausibly read and fill the form). A
           * visitor never sees or edits this field.
           */
        }
        <input type="hidden" name="rendered_at" />
        <button type="submit" class="block-contact__submit">
          {form.submitLabel ?? "Send message"}
        </button>
      </form>
    )}
  </div>
  </Container>
</section>

<script>
  /**
   * Enforces "at least one checked" for a checkbox group marked required —
   * HTML's `required` attribute means "this exact box" per checkbox, so it
   * can't express group semantics the way it does for radio groups. This
   * fills that gap with the native Constraint Validation API rather than
   * custom submit-blocking JS: it sets/clears `setCustomValidity` on the
   * group's first checkbox, so the browser's own validation UI (and
   * `form.reportValidity()` on submit) picks it up like any other invalid
   * field. Progressive enhancement only — a page without JS behaves exactly
   * as it did before (no group-level validation), never worse.
   */
  document.querySelectorAll<HTMLFieldSetElement>("fieldset[data-checkbox-group-required]").forEach((fieldset) => {
    const boxes = Array.from(fieldset.querySelectorAll<HTMLInputElement>('input[type="checkbox"]'));
    const [anchor] = boxes;
    if (!anchor) return;

    const validate = () => {
      anchor.setCustomValidity(boxes.some((box) => box.checked) ? "" : "Select at least one option.");
    };

    boxes.forEach((box) => box.addEventListener("change", validate));
    validate();
  });

  /**
   * A form with no `action` configured has nowhere to submit to yet —
   * letting the browser's default submission proceed would just reload
   * the current page with the fields appended as query params. Instead,
   * treat that specifically as "not wired to a backend yet" and emit a
   * neutral `lead.submitted` event carrying the raw field data (plus the
   * form element itself, so a listener can map a <select>'s chosen
   * label rather than just its slug `value` — see
   * apps/site-builder/src/lib/leadPayload.ts) for whatever site/app-level
   * code wants to act on it — today, apps/site-builder's
   * LeadSubmission.astro, which is what actually calls the platform's
   * public Lead API (POST /public/businesses/{id}/leads). A form that
   * *does* have a real `action` (an active n8n automation, see
   * app.publishing.service._inject_lead_capture_webhook_url on the
   * backend) is left entirely alone here — it submits exactly as HTML
   * already specifies, and this block never dispatches `lead.submitted`
   * for it, so it's never double-posted to both systems.
   */
  document.querySelectorAll<HTMLFormElement>(".block-contact__form").forEach((form) => {
    if (form.getAttribute("action")) return;

    // The submission-timing anti-spam field (see the hidden
    // `rendered_at` input above) — set once, as close to "this form
    // became interactive" as this script runs, never updated again.
    const renderedAtField = form.querySelector<HTMLInputElement>('input[name="rendered_at"]');
    if (renderedAtField) renderedAtField.value = new Date().toISOString();

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const fields = Object.fromEntries(new FormData(form).entries());
      form.dispatchEvent(new CustomEvent("lead.submitted", { detail: { fields, form }, bubbles: true }));
    });
  });
</script>

<style>
  .block-contact {
    padding-block: var(--ui-space-section-md, clamp(3.5rem, 3rem + 2.5vw, 5.5rem));
    background-color: var(--ui-color-bg, #ffffff);
  }

  .block-contact[data-surface="surface"] {
    background-color: var(--ui-color-surface-alt, var(--ui-color-bg, #ffffff));
  }

  .block-contact__panels {
    display: grid;
    grid-template-columns: 1fr;
    border-radius: var(--ui-radius-lg, 0.75rem);
    overflow: hidden;
    border: 1px solid var(--ui-color-border, #e5e7eb);
  }

  .block-contact__info {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding: 2.5rem;
    background-color: var(--ui-color-surface-alt, var(--ui-color-bg, #ffffff));
  }

  .block-contact__intro {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .block-contact__details {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin: 0;
  }

  .block-contact__detail {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .block-contact__detail dt,
  .block-contact__detail dd {
    margin: 0;
  }

  .block-contact__form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 2.5rem;
    background-color: var(--ui-color-bg, #ffffff);
  }

  .block-contact__fields {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .block-contact__field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .block-contact__field label {
    font-family: var(--ui-font-sans, ui-sans-serif, system-ui, sans-serif);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ui-color-fg, #111827);
  }

  .block-contact__field input,
  .block-contact__field textarea,
  .block-contact__field select {
    font-family: var(--ui-font-sans, ui-sans-serif, system-ui, sans-serif);
    font-size: 1rem;
    color: var(--ui-color-fg, #111827);
    background-color: var(--ui-color-bg, #ffffff);
    border: 1px solid var(--ui-color-border, #e5e7eb);
    border-radius: var(--ui-radius, 0.5rem);
    padding: 0.75rem 0.875rem;
    transition: border-color 0.15s ease;
  }

  .block-contact__field input:hover,
  .block-contact__field textarea:hover,
  .block-contact__field select:hover {
    border-color: var(--ui-color-primary, #2563eb);
  }

  .block-contact__field input:focus-visible,
  .block-contact__field textarea:focus-visible,
  .block-contact__field select:focus-visible {
    outline: 2px solid var(--ui-color-primary, #2563eb);
    outline-offset: 1px;
  }

  .block-contact__field textarea {
    resize: vertical;
  }

  .block-contact__fieldset {
    border: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .block-contact__fieldset legend {
    font-family: var(--ui-font-sans, ui-sans-serif, system-ui, sans-serif);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ui-color-fg, #111827);
    padding: 0;
  }

  .block-contact__option-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }

  .block-contact__option {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--ui-font-sans, ui-sans-serif, system-ui, sans-serif);
    font-size: 1rem;
    color: var(--ui-color-fg, #111827);
    cursor: pointer;
  }

  /* Off-screen, not display:none/visibility:hidden (some bots skip
     those) and not visible-to-screen-readers-only (the opposite mistake
     — that would surface it to assistive tech, which a sighted-hiding
     trick like clip/sr-only patterns is meant to avoid for *content*
     but is exactly wrong for a honeypot). aria-hidden + tabindex="-1" on
     the element itself (see the template above) is what actually keeps
     assistive tech away from it; this only keeps it out of sighted
     view. */
  .block-contact__honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .block-contact__submit {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--ui-font-sans, ui-sans-serif, system-ui, sans-serif);
    font-weight: 600;
    font-size: 1rem;
    padding: 0.875rem 2rem;
    border-radius: var(--ui-radius, 0.5rem);
    border: 1px solid transparent;
    cursor: pointer;
    background-color: var(--ui-color-primary, #2563eb);
    color: var(--ui-color-primary-fg, #ffffff);
    transition:
      filter 0.15s ease,
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .block-contact__submit:hover {
    filter: brightness(0.94);
  }

  .block-contact__submit:focus-visible {
    outline: 2px solid var(--ui-color-primary, #2563eb);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .block-contact__submit:active {
      transform: translateY(0) scale(0.98);
    }
  }

  /* Lift/glow only where hover is a real, hover-capable pointer gesture —
     see Button.astro for why this needs its own query, separate from the
     reduced-motion one above (tapping on touch triggers `:hover` and the
     lift would otherwise stay stuck until the visitor taps elsewhere). */
  @media (prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) {
    .block-contact__submit:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 16px -4px color-mix(in srgb, var(--ui-color-primary, #2563eb) 45%, transparent);
    }
  }

  @media (min-width: 640px) {
    .block-contact__fields {
      grid-template-columns: repeat(2, 1fr);
    }

    .block-contact__field[data-span="full"],
    .block-contact__fieldset[data-span="full"] {
      grid-column: 1 / -1;
    }

    .block-contact__submit {
      align-self: flex-end;
    }
  }

  @media (min-width: 900px) {
    .block-contact__panels {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }

    .block-contact__info,
    .block-contact__form {
      padding: 3.5rem;
    }
  }
</style>
