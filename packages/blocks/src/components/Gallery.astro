---
/**
 * Gallery — a grid of items (projects, work samples, portfolio pieces),
 * each with a primary image and an optional before/after pair. Generic
 * across industries: renovation, landscaping, design, photography, etc.
 * all fit the same shape.
 *
 * One item can be marked `featured` to occupy a larger cell in an
 * editorial, art-directed grid; the rest fill in around it. If no item is
 * marked, the first item is treated as featured. Built with plain CSS Grid
 * column-spans in normal (not dense) flow — no masonry library; see the
 * comment above `[data-wide]`/`[data-featured]` in the stylesheet below for
 * why dense repacking was tried and rejected.
 */
import { Badge, Container, Heading, Link, Media, Text } from "@generate-web-ai/ui";
import type { BlockAction, BlockImage } from "../types";

export interface GalleryBeforeAfter {
  before: BlockImage;
  after: BlockImage;
  /** Defaults to "Before". */
  beforeLabel?: string;
  /** Defaults to "After". */
  afterLabel?: string;
}

export interface GalleryItem {
  title: string;
  /** e.g. a service or work type this item belongs to. */
  category?: string;
  image: BlockImage;
  description?: string;
  link?: BlockAction;
  beforeAfter?: GalleryBeforeAfter;
  /** Renders larger in the grid. When no item sets this, the first item is treated as featured. */
  featured?: boolean;
}

export interface GalleryContent {
  heading?: string;
  subheading?: string;
  items: GalleryItem[];
}

export interface Props {
  content: GalleryContent;
  id?: string;
  /** Section surface tone. Defaults to "base". */
  background?: "base" | "surface";
  /** Animates the section into view on scroll. Defaults to true; has no
   * effect when the visitor prefers reduced motion or JS doesn't run. */
  reveal?: boolean;
  class?: string;
}

const { content, id, background = "base", reveal = true, class: className } = Astro.props;
const { heading, subheading, items } = content;
const hasExplicitFeatured = items.some((item) => item.featured);
---

<section id={id} data-surface={background} class:list={["block-gallery", { "block-reveal": reveal }, className]}>
  <Container size="xl">
  {(heading || subheading) && (
    <div class="block-gallery__intro">
      {heading && <Heading level={2} font="display">{heading}</Heading>}
      {subheading && (
        <Text size="lg" variant="muted">
          {subheading}
        </Text>
      )}
    </div>
  )}
  <ul class="block-gallery__grid">
    {items.map((item, index) => {
      const isFeatured = hasExplicitFeatured ? Boolean(item.featured) : index === 0;
      return (
        <li
          class="block-gallery__item"
          data-featured={isFeatured ? "true" : "false"}
          data-wide={item.beforeAfter ? "true" : "false"}
        >
          {item.beforeAfter ? (
            <div class="block-gallery__before-after">
              <div class="block-gallery__ba-figure">
                <Media
                  src={item.beforeAfter.before.src}
                  alt={item.beforeAfter.before.alt}
                  width={item.beforeAfter.before.width}
                  height={item.beforeAfter.before.height}
                  ratio="4/3"
                />
                <span class="block-gallery__ba-label">{item.beforeAfter.beforeLabel ?? "Before"}</span>
              </div>
              <div class="block-gallery__ba-figure">
                <Media
                  src={item.beforeAfter.after.src}
                  alt={item.beforeAfter.after.alt}
                  width={item.beforeAfter.after.width}
                  height={item.beforeAfter.after.height}
                  ratio="4/3"
                />
                <span class="block-gallery__ba-label">{item.beforeAfter.afterLabel ?? "After"}</span>
              </div>
            </div>
          ) : (
            <div class="block-gallery__media">
              <Media
                src={item.image.src}
                alt={item.image.alt}
                width={item.image.width}
                height={item.image.height}
                zoom
                class="block-gallery__media-fill"
              />
            </div>
          )}
          <div class="block-gallery__body">
            {item.category && (
              <Badge as="span" variant="neutral" class="block-gallery__category">
                {item.category}
              </Badge>
            )}
            <Heading level={3} size={isFeatured ? "lg" : "md"}>
              {item.title}
            </Heading>
            {item.description && (
              <Text variant="muted" size="sm">
                {item.description}
              </Text>
            )}
            {item.link && (
              <Link href={item.link.href} class="block-gallery__link" underline="hover">
                {item.link.label} →
              </Link>
            )}
          </div>
        </li>
      );
    })}
  </ul>
  </Container>
</section>

<style>
  .block-gallery {
    padding-block: var(--ui-space-section-lg, clamp(4rem, 3.5rem + 3.5vw, 6.5rem));
    background-color: var(--ui-color-bg, #ffffff);
  }

  .block-gallery[data-surface="surface"] {
    background-color: var(--ui-color-surface-alt, var(--ui-color-bg, #ffffff));
  }

  .block-gallery__intro {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 46rem;
    margin-bottom: 3rem;
  }

  .block-gallery__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .block-gallery__item {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .block-gallery__media {
    aspect-ratio: 4 / 3;
  }

  .block-gallery__media-fill {
    width: 100%;
    height: 100%;
  }

  .block-gallery__before-after {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  .block-gallery__ba-figure {
    position: relative;
  }

  .block-gallery__ba-label {
    position: absolute;
    top: 0.625rem;
    left: 0.625rem;
    padding: 0.25rem 0.625rem;
    font-family: var(--ui-font-sans, ui-sans-serif, system-ui, sans-serif);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ui-color-bg, #ffffff);
    background-color: color-mix(in srgb, var(--ui-color-fg, #111827) 72%, transparent);
    border-radius: var(--ui-radius, 0.5rem);
  }

  .block-gallery__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .block-gallery__category {
    align-self: flex-start;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .block-gallery__link {
    margin-top: 0.25rem;
    align-self: flex-start;
    font-weight: 600;
  }

  @media (min-width: 640px) {
    .block-gallery__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .block-gallery__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
    }

    /* Before/after comparisons and the featured item both get a wider,
       2-column tile — before/after because the comparison needs the width
       to read clearly, featured for visual emphasis (and a slightly larger
       heading, set in the template). Column-span only, in normal (not
       dense) flow: items simply wrap to the next row when they don't fit,
       so placement stays predictable regardless of item count or order —
       dense re-packing was tried here and produced confusing overlaps once
       spans mixed 1/2/3 columns, so it's deliberately avoided. */
    .block-gallery__item[data-wide="true"],
    .block-gallery__item[data-featured="true"] {
      grid-column: span 2;
    }
  }
</style>
