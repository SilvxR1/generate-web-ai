---
/**
 * Process — an ordered sequence of steps (e.g. "how it works"). Rendered as
 * a native <ol> so the sequence is conveyed semantically, not just visually.
 * Distinct from Features: Process is inherently ordered, Features is not.
 */
import { Container, Heading, Text } from "@generate-web-ai/ui";

export interface ProcessStep {
  title: string;
  description: string;
  /** A short decorative glyph or emoji, rendered non-semantically. */
  icon?: string;
}

export interface ProcessContent {
  heading?: string;
  subheading?: string;
  steps: ProcessStep[];
}

export interface Props {
  content: ProcessContent;
  id?: string;
  class?: string;
}

const { content, id, class: className } = Astro.props;
const { heading, subheading, steps } = content;
---

<section id={id} class:list={["block-process", className]}>
  <Container size="lg">
  {(heading || subheading) && (
    <div class="block-process__intro">
      {heading && <Heading level={2}>{heading}</Heading>}
      {subheading && (
        <Text size="lg" variant="muted">
          {subheading}
        </Text>
      )}
    </div>
  )}
  <ol class="block-process__list">
    {steps.map((step, index) => (
      <li class="block-process__item">
        <span class="block-process__number" aria-hidden="true">{index + 1}</span>
        <div class="block-process__body">
          {step.icon && (
            <span class="block-process__icon" aria-hidden="true">
              {step.icon}
            </span>
          )}
          <Heading level={3} size="md">
            {step.title}
          </Heading>
          <Text variant="muted" size="sm">{step.description}</Text>
        </div>
      </li>
    ))}
  </ol>
  </Container>
</section>

<style>
  .block-process {
    padding-block: 3rem;
  }

  .block-process__intro {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 42rem;
    margin-bottom: 2.5rem;
  }

  .block-process__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .block-process__item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .block-process__number {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    background-color: var(--ui-color-primary, #2563eb);
    color: var(--ui-color-primary-fg, #ffffff);
    font-weight: 600;
  }

  .block-process__body {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .block-process__icon {
    font-size: 1.25rem;
    line-height: 1;
  }

  @media (min-width: 640px) {
    .block-process__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .block-process__list {
      grid-template-columns: repeat(4, 1fr);
    }

    .block-process__item {
      flex-direction: column;
    }
  }
</style>
