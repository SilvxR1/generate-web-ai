{
  "name": "@generate-web-ai/website-generator",
  "private": true,
  "version": "0.0.1",
  "description": "Deterministic BusinessConfig -> SiteConfig generator. No AI: a preset-driven mapping, so the existing website engine (packages/site-config, blocks, renderer) can build a real site from configuration alone.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "validate": "vitest run scripts/validate-generated-site.test.ts",
    "generate-from-business-config": "node scripts/generate-from-business-config.ts",
    "test": "vitest run scripts/generate-from-business-config.test.ts src/generateSiteConfig.test.ts src/legal.test.ts"
  },
  "dependencies": {
    "@generate-web-ai/business-config-types": "workspace:*",
    "@generate-web-ai/site-config": "workspace:*"
  },
  "devDependencies": {
    "@generate-web-ai/blocks": "workspace:*",
    "@generate-web-ai/renderer": "workspace:*",
    "astro": "7.2.3",
    "typescript": "6.0.3",
    "vitest": "^3.0.0"
  }
}
