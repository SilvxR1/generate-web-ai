ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://generate_web_ai:generate_web_ai@localhost:5432/generate_web_ai
CREDENTIAL_ENCRYPTION_KEY=
CORS_ORIGINS=["http://localhost:5173"]
N8N_BASE_URL=
N8N_API_KEY=
INTERNAL_API_BASE_URL=http://localhost:8000
INTERNAL_AUTOMATION_TOKEN=
N8N_INTERNAL_AUTOMATION_CREDENTIAL_ID=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
HIGGSFIELD_API_KEY=
HIGGSFIELD_BASE_URL=

# P1.6 — Google Reviews (app.reviews.provider.GoogleReviewProvider). Manual
# review import works fully without these; leaving them unset just means
# GET .../review-providers reports Google as honestly unavailable.
GOOGLE_REVIEWS_API_KEY=
GOOGLE_REVIEWS_PLACE_ID=

# P1.4/P1.7 — real outbound calls (HTTP/DNS/TLS checks, analytics-event
# ingestion), not credentials. Safe real defaults already ship in code;
# override only if you need a different budget for this deployment.
WEBSITE_HEALTH_RATE_LIMIT_PER_MINUTE=6
PUBLIC_ANALYTICS_RATE_LIMIT_PER_MINUTE=60
