ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://generate_web_ai:generate_web_ai@localhost:5432/generate_web_ai
CREDENTIAL_ENCRYPTION_KEY=
CORS_ORIGINS=["http://localhost:5173"]
N8N_BASE_URL=
N8N_API_KEY=
INTERNAL_API_BASE_URL=http://localhost:8000
INTERNAL_AUTOMATION_TOKEN=
N8N_INTERNAL_AUTOMATION_CREDENTIAL_ID=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
# LEGACY — the old, inert P0-era HTTP scaffolding for the OLD CreativeLevel
# PREMIUM/CINEMATIC tier (app.creative.orchestrator.select_provider). NOT
# the real P2 Higgsfield Creative Director — see HIGGSFIELD_API_KEY_ID/
# HIGGSFIELD_API_KEY_SECRET below for that.
HIGGSFIELD_API_KEY=
HIGGSFIELD_BASE_URL=

# P2.1 — the REAL, production Higgsfield Creative Director
# (app.creative.higgsfield.api_client.HiggsfieldApiClient): a server-side
# API key pair created in Higgsfield Cloud (https://cloud.higgsfield.ai),
# sent as `Authorization: Key <ID>:<SECRET>`. Both must be set for
# app.dependencies.get_optional_higgsfield_director to use the official
# REST API; leaving either unset falls back to InternalCreativeDirector
# (or, for local/manual testing only, the higgsfield_cli_enabled path
# below — never selected in production). HIGGSFIELD_API_KEY_NAME is
# optional, non-secret operator metadata (the key's display name in
# Higgsfield Cloud), never used for authentication.
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
HIGGSFIELD_API_KEY_NAME=

# Local development / manual real_provider test ONLY — never set these in
# production (see docs/higgsfield-integration.md for why the CLI/OAuth
# path is not production-safe).
HIGGSFIELD_CLI_ENABLED=false

# P2.1 — CloudflareR2StorageProvider (app.storage.r2): persistent
# production artifact storage for GenerativeWebsiteArtifact source
# archives and Visual QA screenshots, replacing LocalStorageProvider's
# ephemeral Railway disk. Leaving any of these unset falls back to
# LocalStorageProvider (dev/test default) — see
# app.dependencies.get_storage_provider.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# P1.6 — Google Reviews (app.reviews.provider.GoogleReviewProvider). Manual
# review import works fully without these; leaving them unset just means
# GET .../review-providers reports Google as honestly unavailable.
GOOGLE_REVIEWS_API_KEY=
GOOGLE_REVIEWS_PLACE_ID=

# P1.4/P1.7 — real outbound calls (HTTP/DNS/TLS checks, analytics-event
# ingestion), not credentials. Safe real defaults already ship in code;
# override only if you need a different budget for this deployment.
WEBSITE_HEALTH_RATE_LIMIT_PER_MINUTE=6
PUBLIC_ANALYTICS_RATE_LIMIT_PER_MINUTE=60
