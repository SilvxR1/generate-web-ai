---
/**
 * BookingCalendar — real day/time/service picker backed by Cloudflare D1
 * (see src/lib/booking/db.ts and src/pages/api/booking/*.ts). Availability
 * is fetched per-request from the database, and "Confirmar cita" writes a
 * real row — the previous in-memory mock (src/data/appointments.ts) has
 * been removed.
 *
 * It's the one piece of real client-side JavaScript in this client app
 * (everything else — the mobile nav, the FAQ-style disclosures elsewhere in
 * the shared blocks — is intentionally zero-JS); a day/time/service picker
 * with live selection state and network round-trips genuinely needs it,
 * unlike those.
 */
import { Button, Card, Container, Heading, Text } from "@generate-web-ai/ui";

export interface Props {
  id?: string;
}

const { id } = Astro.props;
---

<section id={id} class="booking">
  <Container size="md">
    <div class="booking__intro">
      <Heading level={2} font="display">Reserva tu cita</Heading>
      <Text size="lg" variant="muted">Elige servicio, día y hora. Confirmamos tu cita al instante.</Text>
    </div>

    <Card variant="outlined" padding="lg" class="booking__panel">
      <noscript>
        <Text variant="muted">
          Este selector necesita JavaScript para funcionar. Mientras tanto, escríbenos desde el
          <a href="#contacto">formulario de contacto</a>.
        </Text>
      </noscript>

      <Text as="p" variant="muted" class="booking__loading" data-booking-init-loading>Cargando disponibilidad…</Text>
      <Text as="p" class="booking__error" data-booking-init-error hidden>
        No se pudo cargar el calendario. Actualiza la página para intentarlo de nuevo.
      </Text>

      <div class="booking__app" data-booking-app hidden>
        <div class="booking__field" data-booking-service-field>
          <label for="booking-service">Servicio</label>
          <select id="booking-service" data-booking-service></select>
        </div>

        <div class="booking__step">
          <p class="booking__step-label">Elige un día</p>
          <div class="booking__days" data-booking-days role="list" aria-label="Días disponibles"></div>
        </div>

        <div class="booking__step" data-booking-slots-step>
          <p class="booking__step-label">Elige una hora</p>
          <Text as="p" variant="muted" class="booking__loading" data-booking-slots-loading hidden>Cargando horarios…</Text>
          <div class="booking__slots" data-booking-slots aria-live="polite"></div>
        </div>

        <div class="booking__contact" data-booking-contact hidden>
          <p class="booking__step-label">Tus datos</p>
          <div class="booking__contact-fields">
            <div class="booking__field">
              <label for="booking-name">Nombre</label>
              <input id="booking-name" type="text" autocomplete="name" data-booking-name required />
            </div>
            <div class="booking__field">
              <label for="booking-phone">Teléfono</label>
              <input id="booking-phone" type="tel" autocomplete="tel" data-booking-phone required />
            </div>
            <div class="booking__field">
              <label for="booking-email">Email (opcional)</label>
              <input id="booking-email" type="email" autocomplete="email" data-booking-email />
            </div>
            <div class="booking__field booking__field--wide">
              <label for="booking-notes">Notas (opcional)</label>
              <textarea id="booking-notes" rows="2" data-booking-notes></textarea>
            </div>
          </div>
          <!--
            Honeypot: hidden from sighted users (CSS below), skipped by
            keyboard users (`tabindex="-1"`), and skipped entirely by screen
            readers (`aria-hidden`) — a real visitor never sees or fills
            this in, so a submission with it filled almost certainly isn't
            human. See src/pages/api/booking/reserve.ts for the server side.
          -->
          <div class="booking__honeypot" aria-hidden="true">
            <label for="booking-website">Deja este campo vacío</label>
            <input id="booking-website" type="text" tabindex="-1" autocomplete="off" data-booking-honeypot />
          </div>
        </div>

        <div class="booking__summary" data-booking-summary hidden>
          <Text as="p" class="booking__summary-text" />
          <Text as="p" class="booking__error" data-booking-submit-error hidden />
          <Button class="booking__confirm" size="lg" data-booking-confirm-btn>Confirmar cita</Button>
        </div>

        <div class="booking__confirmation" data-booking-confirmation hidden>
          <p class="booking__confirmation-icon" aria-hidden="true">✓</p>
          <Heading level={3} size="lg">¡Cita confirmada!</Heading>
          <Text class="booking__confirmation-text" />
          <Button variant="outline" class="booking__reset">Reservar otra cita</Button>
        </div>
      </div>
    </Card>
  </Container>
</section>

<style>
  .booking {
    padding-block: var(--ui-space-section-lg, clamp(4rem, 3.5rem + 3.5vw, 6.5rem));
  }

  .booking__intro {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .booking__panel {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .booking__loading {
    margin: 0;
  }

  .booking__error {
    margin: 0;
    color: var(--ui-color-danger, #dc2626);
  }

  .booking__field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    max-width: 22rem;
  }

  .booking__field label {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .booking__field select,
  .booking__field input,
  .booking__field textarea {
    font-family: var(--ui-font-sans);
    font-size: 1rem;
    color: var(--ui-color-fg);
    background-color: var(--ui-color-bg);
    border: 1px solid var(--ui-color-border);
    border-radius: var(--ui-radius);
    padding: 0.625rem 0.75rem;
  }

  .booking__field textarea {
    resize: vertical;
  }

  .booking__field select:focus-visible,
  .booking__field input:focus-visible,
  .booking__field textarea:focus-visible {
    outline: 2px solid var(--ui-color-primary);
    outline-offset: 1px;
  }

  .booking__step-label {
    margin: 0 0 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ui-color-muted-fg);
  }

  .booking__days {
    display: flex;
    gap: 0.625rem;
    overflow-x: auto;
    padding-bottom: 0.25rem;
    scrollbar-width: thin;
  }

  .booking__slots {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(4.5rem, 1fr));
    gap: 0.625rem;
  }

  .booking__slots:empty::after {
    content: "Elige un día para ver las horas disponibles.";
    grid-column: 1 / -1;
    color: var(--ui-color-muted-fg);
    font-size: 0.9375rem;
  }

  .booking__contact-fields {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .booking__contact-fields .booking__field {
    max-width: none;
  }

  .booking__field--wide {
    grid-column: 1 / -1;
  }

  /* Same off-screen technique Layout.astro's skip-link already uses —
     present in the DOM (so a naive bot still finds and fills it) but
     invisible and untouchable for a real visitor. */
  .booking__honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .booking__summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--ui-color-border);
  }

  .booking__summary-text {
    font-weight: 600;
  }

  .booking__confirmation {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.625rem;
  }

  .booking__confirmation-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    margin: 0 0 0.25rem;
    border-radius: 9999px;
    background-color: var(--ui-color-primary);
    color: var(--ui-color-primary-fg);
    font-size: 1.125rem;
    font-weight: 700;
  }

  @media (min-width: 640px) {
    .booking__summary {
      flex-wrap: nowrap;
    }

    .booking__contact-fields {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<!--
  Astro's scoped styles only reach elements present in the HTML at build
  time — each gets a `data-astro-cid-*` attribute, and the component's
  `<style>` selectors are compiled to require it. `.booking__day`/
  `.booking__slot` and their children are created by the client script
  below via `document.createElement`, so they never get that attribute:
  a scoped rule for them would silently never match. This block is the
  same `is:global` escape hatch Layout.astro already uses for the
  skip-link — unscoped on purpose, for content this component creates
  itself at runtime rather than renders in its own template.
-->
<style is:global>
  .booking__day {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
    width: 3.75rem;
    padding-block: 0.625rem;
    font-family: var(--ui-font-sans);
    color: var(--ui-color-fg);
    background-color: var(--ui-color-bg);
    border: 1px solid var(--ui-color-border);
    border-radius: var(--ui-radius);
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .booking__day-weekday {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ui-color-muted-fg);
  }

  .booking__day-number {
    font-size: 1.125rem;
    font-weight: 700;
  }

  .booking__day-month {
    font-size: 0.6875rem;
    color: var(--ui-color-muted-fg);
  }

  .booking__day:hover:not(:disabled) {
    border-color: var(--ui-color-primary);
  }

  .booking__day[aria-pressed="true"] {
    background-color: var(--ui-color-primary);
    border-color: var(--ui-color-primary);
  }

  .booking__day[aria-pressed="true"] .booking__day-weekday,
  .booking__day[aria-pressed="true"] .booking__day-month {
    color: color-mix(in srgb, var(--ui-color-primary-fg) 70%, transparent);
  }

  .booking__day[aria-pressed="true"] .booking__day-number {
    color: var(--ui-color-primary-fg);
  }

  .booking__day:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .booking__slot {
    padding-block: 0.625rem;
    font-family: var(--ui-font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ui-color-fg);
    background-color: var(--ui-color-bg);
    border: 1px solid var(--ui-color-border);
    border-radius: var(--ui-radius);
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .booking__slot:hover:not(:disabled) {
    border-color: var(--ui-color-primary);
  }

  .booking__slot[aria-pressed="true"] {
    background-color: var(--ui-color-primary);
    border-color: var(--ui-color-primary);
    color: var(--ui-color-primary-fg);
  }

  .booking__slot:disabled {
    opacity: 0.35;
    text-decoration: line-through;
    cursor: not-allowed;
  }
</style>

<script>
  import type { BookingDayConfig, BookingServiceConfig, BookingSlotConfig } from "@generate-web-ai/site-config";

  interface AvailabilityResponse {
    days: BookingDayConfig[];
    services: BookingServiceConfig[];
  }

  interface SlotsResponse {
    date: string;
    slots: BookingSlotConfig[];
  }

  const weekdayFormatter = new Intl.DateTimeFormat("es-ES", { weekday: "short" });
  const monthFormatter = new Intl.DateTimeFormat("es-ES", { month: "short" });

  /** Parses "YYYY-MM-DD" as a *local* calendar date (not UTC midnight) — the
   * server generates dates the same way, so this avoids the date shifting
   * by a day for visitors browsing from a timezone behind the shop's. */
  function parseISODate(dateISO: string): Date {
    const [year, month, day] = dateISO.split("-").map(Number);
    return new Date(year!, month! - 1, day!);
  }

  function formatPriceCents(cents: number): string {
    return `${(cents / 100).toFixed(2).replace(".", ",")} €`;
  }

  const app = document.querySelector<HTMLElement>("[data-booking-app]");
  const initLoading = document.querySelector<HTMLElement>("[data-booking-init-loading]");
  const initError = document.querySelector<HTMLElement>("[data-booking-init-error]");

  if (app && initLoading && initError) {
    const serviceSelect = app.querySelector<HTMLSelectElement>("[data-booking-service]")!;
    const serviceField = app.querySelector<HTMLElement>("[data-booking-service-field]")!;
    const daysEl = app.querySelector<HTMLElement>("[data-booking-days]")!;
    const slotsStep = app.querySelector<HTMLElement>("[data-booking-slots-step]")!;
    const slotsLoading = app.querySelector<HTMLElement>("[data-booking-slots-loading]")!;
    const slotsEl = app.querySelector<HTMLElement>("[data-booking-slots]")!;
    const contactEl = app.querySelector<HTMLElement>("[data-booking-contact]")!;
    const nameInput = app.querySelector<HTMLInputElement>("[data-booking-name]")!;
    const phoneInput = app.querySelector<HTMLInputElement>("[data-booking-phone]")!;
    const emailInput = app.querySelector<HTMLInputElement>("[data-booking-email]")!;
    const notesInput = app.querySelector<HTMLTextAreaElement>("[data-booking-notes]")!;
    const honeypotInput = app.querySelector<HTMLInputElement>("[data-booking-honeypot]")!;
    const summaryEl = app.querySelector<HTMLElement>("[data-booking-summary]")!;
    // These four are rendered by @generate-web-ai/ui's `Text`/`Button`, which
    // — unlike `Card` — don't forward arbitrary `data-*` attributes (only
    // the props they explicitly declare, `class` among them). Selecting by
    // class instead of a `data-*` hook is what actually reaches the
    // rendered element for these two components.
    const summaryText = app.querySelector<HTMLElement>(".booking__summary-text")!;
    const submitError = app.querySelector<HTMLElement>("[data-booking-submit-error]")!;
    const confirmBtn = app.querySelector<HTMLButtonElement>("[data-booking-confirm-btn]")!;
    const confirmationEl = app.querySelector<HTMLElement>("[data-booking-confirmation]")!;
    const confirmationText = app.querySelector<HTMLElement>(".booking__confirmation-text")!;
    const resetBtn = app.querySelector<HTMLButtonElement>(".booking__reset")!;

    let services: BookingServiceConfig[] = [];
    let days: BookingDayConfig[] = [];
    let selectedDay: BookingDayConfig | undefined;
    let selectedTime: string | undefined;
    let submitting = false;

    function dayLabel(day: BookingDayConfig): string {
      const date = parseISODate(day.dateISO);
      return `${weekdayFormatter.format(date)} ${date.getDate()} ${monthFormatter.format(date)}`;
    }

    function currentService(): BookingServiceConfig | undefined {
      return services.find((s) => s.id === serviceSelect.value);
    }

    // Delegated listeners (below, on the static `daysEl`/`slotsEl`
    // containers) rather than one `addEventListener` per generated button:
    // a listener on the static parent never needs to be reattached when
    // `renderDays()`/`renderSlots()` wipe and recreate their children, so
    // there's no risk of a freshly-created button ending up without one.
    function renderDays() {
      daysEl.innerHTML = "";
      for (const day of days) {
        const date = parseISODate(day.dateISO);
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "booking__day";
        btn.disabled = !day.isOpen;
        btn.dataset.date = day.dateISO;
        btn.setAttribute("aria-pressed", String(day.dateISO === selectedDay?.dateISO));
        btn.setAttribute("aria-label", day.isOpen ? dayLabel(day) : `${dayLabel(day)}, cerrado`);
        btn.innerHTML = `<span class="booking__day-weekday">${weekdayFormatter.format(date)}</span><span class="booking__day-number">${date.getDate()}</span><span class="booking__day-month">${monthFormatter.format(date)}</span>`;
        daysEl.append(btn);
      }
    }

    function renderSlots(slots: BookingSlotConfig[]) {
      slotsEl.innerHTML = "";
      for (const slot of slots) {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "booking__slot";
        btn.textContent = slot.time;
        btn.disabled = !slot.available;
        btn.dataset.time = slot.time;
        btn.setAttribute("aria-pressed", String(slot.time === selectedTime));
        btn.setAttribute("aria-label", slot.available ? slot.time : `${slot.time}, no disponible`);
        slotsEl.append(btn);
      }
    }

    async function selectDay(day: BookingDayConfig) {
      selectedDay = day;
      selectedTime = undefined;
      renderDays();
      contactEl.hidden = true;
      updateSummary();

      slotsEl.hidden = true;
      slotsEl.innerHTML = "";
      slotsLoading.hidden = false;
      try {
        const res = await fetch(`/api/booking/availability?date=${day.dateISO}`);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data: SlotsResponse = await res.json();
        renderSlots(data.slots);
      } catch (error) {
        console.error("[booking] failed to load slots for", day.dateISO, error);
        slotsEl.innerHTML = `<p class="booking__error">No se pudieron cargar los horarios. Prueba de nuevo.</p>`;
      } finally {
        slotsLoading.hidden = true;
        slotsEl.hidden = false;
      }
    }

    function selectTime(time: string) {
      selectedTime = time;
      renderSlots(
        Array.from(slotsEl.querySelectorAll<HTMLButtonElement>("button[data-time]")).map((btn) => ({
          time: btn.dataset.time!,
          available: !btn.disabled,
        })),
      );
      contactEl.hidden = false;
      updateSummary();
    }

    daysEl.addEventListener("click", (event) => {
      const btn = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-date]");
      if (!btn || btn.disabled) return;
      const day = days.find((d) => d.dateISO === btn.dataset.date);
      if (day) void selectDay(day);
    });

    slotsEl.addEventListener("click", (event) => {
      const btn = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-time]");
      if (!btn || btn.disabled || !btn.dataset.time) return;
      selectTime(btn.dataset.time);
    });

    function updateSummary() {
      submitError.hidden = true;
      const service = currentService();
      const contactValid = nameInput.value.trim() !== "" && phoneInput.value.trim() !== "";
      if (selectedDay && selectedTime && service && contactValid) {
        summaryText.textContent = `${service.name} (${formatPriceCents(service.priceCents)}) · ${dayLabel(selectedDay)}, ${selectedTime}`;
        summaryEl.hidden = false;
        confirmBtn.disabled = false;
      } else if (selectedDay && selectedTime && service) {
        summaryText.textContent = `${service.name} (${formatPriceCents(service.priceCents)}) · ${dayLabel(selectedDay)}, ${selectedTime}. Añade tu nombre y teléfono para confirmar.`;
        summaryEl.hidden = false;
        confirmBtn.disabled = true;
      } else {
        summaryEl.hidden = true;
      }
    }

    serviceSelect.addEventListener("change", updateSummary);
    nameInput.addEventListener("input", updateSummary);
    phoneInput.addEventListener("input", updateSummary);

    confirmBtn.addEventListener("click", async () => {
      if (!selectedDay || !selectedTime || submitting) return;
      const service = currentService();
      if (!service) return;

      submitting = true;
      confirmBtn.disabled = true;
      submitError.hidden = true;

      try {
        const res = await fetch("/api/booking/reserve", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            serviceId: service.id,
            date: selectedDay.dateISO,
            time: selectedTime,
            name: nameInput.value,
            phone: phoneInput.value,
            email: emailInput.value || undefined,
            notes: notesInput.value || undefined,
            website: honeypotInput.value,
          }),
        });

        if (res.status === 201) {
          confirmationText.textContent = `Te esperamos el ${dayLabel(selectedDay)} a las ${selectedTime} para ${service.name.toLowerCase()}.`;
          serviceField.hidden = true;
          daysEl.hidden = true;
          slotsStep.hidden = true;
          contactEl.hidden = true;
          summaryEl.hidden = true;
          confirmationEl.hidden = false;
          confirmationEl.querySelector("h3")?.scrollIntoView({ behavior: "smooth", block: "nearest" });
          return;
        }

        const data = await res.json().catch(() => ({}));
        if (res.status === 409) {
          submitError.textContent = data.error ?? "Esa hora ya no está disponible. Elige otra.";
          submitError.hidden = false;
          selectedTime = undefined;
          contactEl.hidden = true;
          summaryEl.hidden = true;
          await selectDay(selectedDay);
        } else {
          submitError.textContent = data.error ?? "No se pudo confirmar la cita. Inténtalo de nuevo.";
          submitError.hidden = false;
        }
      } catch (error) {
        console.error("[booking] failed to submit reservation", error);
        submitError.textContent = "No se pudo confirmar la cita. Comprueba tu conexión e inténtalo de nuevo.";
        submitError.hidden = false;
      } finally {
        submitting = false;
        confirmBtn.disabled = false;
      }
    });

    resetBtn.addEventListener("click", () => {
      selectedDay = undefined;
      selectedTime = undefined;
      nameInput.value = "";
      phoneInput.value = "";
      emailInput.value = "";
      notesInput.value = "";
      confirmationEl.hidden = true;
      serviceField.hidden = false;
      daysEl.hidden = false;
      slotsStep.hidden = false;
      contactEl.hidden = true;
      renderDays();
      slotsEl.innerHTML = "";
      updateSummary();
    });

    (async () => {
      try {
        const res = await fetch("/api/booking/availability");
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data: AvailabilityResponse = await res.json();
        days = data.days;
        services = data.services;

        for (const service of services) {
          const el = document.createElement("option");
          el.value = service.id;
          el.textContent = `${service.name} — ${formatPriceCents(service.priceCents)}`;
          serviceSelect.append(el);
        }
        renderDays();

        initLoading.hidden = true;
        app.hidden = false;
      } catch (error) {
        console.error("[booking] failed to load initial availability", error);
        initLoading.hidden = true;
        initError.hidden = false;
      }
    })();
  }
</script>
