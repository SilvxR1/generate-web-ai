{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sacri-barber",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sacri-barber-db",
      "database_id": "d9c3f062-6dd6-4801-9744-2f1a393035f5",
      "migrations_dir": "migrations"
    }
  ]
}
