---
/**
 * Proves the page composition system end to end: a SiteConfig (data) is
 * rendered through PageRenderer into real Astro output. Not a client site —
 * a validation fixture for the renderer, using @generate-web-ai/site-config's
 * example config that covers all current block types.
 */
import "../styles/global.css";
import { PageRenderer } from "@generate-web-ai/renderer";
import { exampleSiteConfig } from "@generate-web-ai/site-config";

const page = exampleSiteConfig.pages[0];
if (!page) {
  throw new Error("exampleSiteConfig has no pages to render.");
}
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{exampleSiteConfig.brand.name} — example</title>
  </head>
  <body>
    <main>
      <PageRenderer page={page} />
    </main>
  </body>
</html>
