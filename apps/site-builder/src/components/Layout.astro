---
/**
 * Layout — the generic page shell: <head>/SEO wiring, theme application,
 * a minimal brand header, and a footer + cookie consent banner around
 * whatever page content is passed via <slot />. Mirrors the same role
 * apps/clients/*'s own Layout.astro plays (see that docstring) —
 * packages/renderer deliberately leaves theme application and page
 * chrome to the consuming app; this is that piece for the generic,
 * any-business build engine.
 *
 * Deliberately minimal compared to a hand-authored client's Layout: no
 * navigation, no extra derived color roles — those were legitimate for
 * one curated client but aren't principled generic defaults for an
 * arbitrary AI-proposed business, so they're left out rather than
 * guessed at. The footer and consent banner are the one addition to
 * that original minimalism (P0 Phase 16-19): every generated site now
 * always has legal pages (packages/website-generator's legal.ts) and a
 * real consent mechanism (CookieConsentBanner.astro), so this shell is
 * the one principled place to surface both on every page, not something
 * being invented per business. Only the five ThemeConfig color roles +
 * fonts + radius get wired, straight from SiteConfig, no invention.
 *
 * Theme values are business-supplied, free-form strings (BrandColors
 * explicitly isn't restricted to hex — see app/domain/business_config/
 * brand.py on the backend). They're applied via Astro's `style` object
 * prop (a normal, auto-escaped attribute), never `set:html`/`is:raw` —
 * a raw `set:html` style block here would let a value containing
 * `</style>` break out of the tag and inject real markup.
 */
import type { SiteConfig } from "@generate-web-ai/site-config";
import Analytics from "./Analytics.astro";
import CookieConsentBanner from "./CookieConsentBanner.astro";
import LeadSubmission from "./LeadSubmission.astro";
import WhatsAppFloatingButton from "./WhatsAppFloatingButton.astro";
import "../styles/global.css";

export interface Props {
  siteConfig: SiteConfig;
}

const { siteConfig } = Astro.props;
const { theme, seo, brand, pages, whatsapp, businessId, navigation } = siteConfig;
// A8.3.3: header navigation, generated only for sections that render (see
// packages/website-generator navigation.ts). `?? []` also covers a JSON null.
const navItems = navigation ?? [];
const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL as string | undefined;

// Same digits-only + optional prefilled-message shape
// @generate-web-ai/website-generator's toWhatsAppHref already produces —
// duplicated here rather than imported since that helper lives in a
// package with no Astro/browser runtime dependency of its own; this is
// the one other place a real wa.me link needs building (the floating
// button, which packages/website-generator has no block/placement for).
const whatsappFloatingHref =
  whatsapp?.enabled && whatsapp.showFloatingButton
    ? `https://wa.me/${whatsapp.phoneNumber.replace(/\D/g, "")}${
        whatsapp.defaultMessage ? `?text=${encodeURIComponent(whatsapp.defaultMessage)}` : ""
      }`
    : null;

// Only linked when the SiteConfig actually has that page — never a
// dead link guessed at for a business that (in principle, even though
// packages/website-generator always adds all three today) doesn't have
// one.
const LEGAL_LINKS: ReadonlyArray<{ path: string; label: string }> = [
  { path: "/privacy", label: "Privacy Policy" },
  { path: "/terms", label: "Terms of Service" },
  { path: "/cookies", label: "Cookie Policy" },
];
const legalLinks = LEGAL_LINKS.filter((link) => pages.some((page) => page.path === link.path));
const currentYear = new Date().getFullYear();

const themeStyle: Record<string, string> = {
  "--ui-font-sans": theme.fonts.sans,
  "--ui-color-fg": theme.colors.foreground,
  "--ui-color-bg": theme.colors.background,
  "--ui-color-border": theme.colors.secondary,
  "--ui-color-primary": theme.colors.accent,
  "--ui-radius": theme.radius.base,
  "--ui-radius-lg": theme.radius.lg,
};
if (theme.fonts.display) {
  themeStyle["--ui-font-display"] = theme.fonts.display;
}
// A8.2.3 density: only emitted when a creative direction set it —
// otherwise every block keeps its own built-in section spacing (today's).
if (theme.spacing) {
  themeStyle["--ui-space-section-sm"] = theme.spacing.sectionSm;
  themeStyle["--ui-space-section-md"] = theme.spacing.sectionMd;
  themeStyle["--ui-space-section-lg"] = theme.spacing.sectionLg;
}
---

<html lang="en" style={themeStyle}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
  </head>
  <body>
    {/* A8.3.3: the header owns identity + navigation. The tagline is real
      * brand data but belongs to the hero (A8.3.2), so it isn't repeated here. */}
    <header class="site-header">
      <a class="site-header__home" href="/">
        {brand.logo ? (
          <img
            class="site-header__logo"
            src={typeof brand.logo.src === "string" ? brand.logo.src : brand.logo.src.src}
            alt={brand.logo.alt}
          />
        ) : (
          <span class="site-header__brand">{brand.name}</span>
        )}
      </a>
      {navItems.length > 0 && (
        <nav class="site-nav" aria-label="Main">
          <ul class="site-nav__list">
            {navItems.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
          <details class="site-nav__menu">
            <summary>Menu</summary>
            <ul>
              {navItems.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
            </ul>
          </details>
        </nav>
      )}
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p class="site-footer__copyright">&copy; {currentYear} {brand.name}</p>
      {legalLinks.length > 0 && (
        <nav class="site-footer__links" aria-label="Legal">
          {legalLinks.map((link) => (
            <a href={link.path}>{link.label}</a>
          ))}
          <button type="button" data-open-consent-preferences class="site-footer__consent-link">
            Manage cookie preferences
          </button>
        </nav>
      )}
    </footer>
    <CookieConsentBanner />
    {whatsappFloatingHref && <WhatsAppFloatingButton href={whatsappFloatingHref} />}
    <Analytics businessId={businessId} whatsappTrackingEnabled={whatsapp?.trackingEnabled !== false} />
    <LeadSubmission businessId={businessId} apiBaseUrl={apiBaseUrl} />
  </body>
</html>

<style>
  body {
    margin: 0;
    background-color: var(--ui-color-bg, #ffffff);
    color: var(--ui-color-fg, #111827);
    font-family: var(--ui-font-sans, system-ui, sans-serif);
  }

  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding: 0.875rem 1.25rem;
    border-bottom: 1px solid var(--ui-color-border, #e5e7eb);
  }

  .site-header__home {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    max-width: 100%;
    color: inherit;
    text-decoration: none;
  }

  .site-header__brand {
    font-family: var(--ui-font-display, var(--ui-font-sans, system-ui, sans-serif));
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  /* Legible without dominating: contained (never cropped), aspect ratio kept. */
  .site-header__logo {
    display: block;
    max-height: 3rem;
    max-width: min(11rem, 60vw);
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .site-header a:focus-visible,
  .site-nav summary:focus-visible {
    outline: 2px solid var(--ui-color-primary, #2563eb);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* Stays right-aligned even when a long business name wraps it to its own row. */
  .site-nav {
    margin-left: auto;
  }

  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav a {
    color: inherit;
    text-decoration: none;
    font-weight: 500;
  }

  .site-nav a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* Mobile: a native disclosure (no JavaScript); the inline list is hidden. */
  .site-nav__list {
    display: none;
  }

  .site-nav__menu summary {
    cursor: pointer;
    list-style: none;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--ui-color-border, #e5e7eb);
    border-radius: var(--ui-radius, 0.5rem);
    font-weight: 600;
  }

  .site-nav__menu summary::-webkit-details-marker {
    display: none;
  }

  .site-nav__menu ul {
    position: absolute;
    left: 0;
    right: 0;
    z-index: 10;
    display: flex;
    flex-direction: column;
    padding: 0.5rem 1.25rem 1rem;
    background-color: var(--ui-color-bg, #ffffff);
    border-bottom: 1px solid var(--ui-color-border, #e5e7eb);
  }

  .site-nav__menu li a {
    display: block;
    padding: 0.75rem 0;
  }

  .site-header {
    position: relative;
  }

  @media (min-width: 768px) {
    .site-header {
      padding: 1rem 2rem;
    }

    .site-header__logo {
      max-height: 4rem;
      max-width: 14rem;
    }

    .site-header__brand {
      font-size: 1.5rem;
    }

    .site-nav__list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.75rem;
    }

    .site-nav__menu {
      display: none;
    }
  }

  .site-footer {
    padding: 1.5rem;
    border-top: 1px solid var(--ui-color-border, #e5e7eb);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    font-size: 0.85rem;
    opacity: 0.85;
  }

  .site-footer__copyright {
    margin: 0;
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .site-footer__links a {
    color: inherit;
  }

  .site-footer__consent-link {
    font: inherit;
    font-size: inherit;
    color: inherit;
    background: none;
    border: none;
    padding: 0;
    text-decoration: underline;
    cursor: pointer;
  }
</style>
