---
/**
 * The one page this app builds: an arbitrary SiteConfig — read from a
 * JSON file at the path SITE_CONFIG_PATH points to — rendered through
 * the real @generate-web-ai/renderer/blocks pipeline, the exact same
 * PageRenderer apps/clients/* use. `astro build` (invoked by apps/api's
 * app.publishing.build, one subprocess per publish, each with its own
 * SITE_CONFIG_PATH/--outDir) produces this page's real, production
 * HTML/CSS/asset output — never a second, simplified renderer.
 *
 * Falls back to @generate-web-ai/site-config's own exampleSiteConfig
 * when SITE_CONFIG_PATH isn't set — the same "validation fixture, not a
 * client site" role apps/site-template's example.astro plays — so a
 * bare `pnpm build`/`turbo run build` across the whole monorepo still
 * succeeds for this app instead of only working when invoked from the
 * publishing pipeline.
 */
import fs from "node:fs";
import type { SiteConfig } from "@generate-web-ai/site-config";
import { exampleSiteConfig } from "@generate-web-ai/site-config";
import { PageRenderer } from "@generate-web-ai/renderer";
import Layout from "../components/Layout.astro";

const configPath = process.env.SITE_CONFIG_PATH;
const siteConfig: SiteConfig = configPath ? JSON.parse(fs.readFileSync(configPath, "utf-8")) : exampleSiteConfig;
const page = siteConfig.pages[0];
if (!page) {
  throw new Error("This SiteConfig has no pages to render.");
}
---

<Layout siteConfig={siteConfig}>
  <PageRenderer page={page} />
</Layout>
