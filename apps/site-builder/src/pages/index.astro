---
/**
 * The homepage: an arbitrary SiteConfig's `path: "/"` page — read from a
 * JSON file at the path SITE_CONFIG_PATH points to — rendered through
 * the real @generate-web-ai/renderer/blocks pipeline, the exact same
 * PageRenderer apps/clients/* use. `astro build` (invoked by apps/api's
 * app.publishing.build, one subprocess per publish, each with its own
 * SITE_CONFIG_PATH/--outDir) produces this page's real, production
 * HTML/CSS/asset output — never a second, simplified renderer.
 *
 * Every other page in the SiteConfig (e.g. the legal pages
 * packages/website-generator always adds) is built by [...slug].astro,
 * not here — this file is homepage-only.
 */
import { PageRenderer } from "@generate-web-ai/renderer";
import Layout from "../components/Layout.astro";
import { loadSiteConfig } from "../lib/loadSiteConfig.ts";

const siteConfig = loadSiteConfig();
const page = siteConfig.pages.find((candidate) => candidate.path === "/");
if (!page) {
  throw new Error("This SiteConfig has no page at \"/\" to render.");
}
---

<Layout siteConfig={siteConfig}>
  <PageRenderer page={page} />
</Layout>
