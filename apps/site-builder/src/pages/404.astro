---
/**
 * C2.1: the site's real "not found" page. Cloudflare Pages serves a
 * top-level 404.html with HTTP 404 for any unknown path; without it Pages
 * falls back to index.html with a 200 (a soft 404 for every bad URL,
 * robots.txt and sitemap.xml included). Never indexed, never canonical.
 */
import Layout from "../components/Layout.astro";
import { chromeStrings } from "../lib/i18n.ts";
import { loadSiteConfig } from "../lib/loadSiteConfig.ts";

const siteConfig = loadSiteConfig();
const strings = chromeStrings(siteConfig).notFound;
---

<Layout siteConfig={siteConfig} pagePath="/404" noindex title={`${strings.title} · ${siteConfig.brand.name}`}>
  <section class="not-found">
    <h1>{strings.heading}</h1>
    <p>{strings.body}</p>
    <p><a href="/">{strings.home}</a></p>
  </section>
</Layout>

<style>
  .not-found {
    max-width: 40rem;
    margin: 0 auto;
    padding: 4rem 1.25rem;
    text-align: center;
  }

  .not-found a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
