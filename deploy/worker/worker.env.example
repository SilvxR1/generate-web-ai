# /etc/gwa-worker/worker.env — NON-SECRET worker configuration (root:root 0644).
# The worker token is NOT here: it lives in /etc/gwa-worker/worker-token
# (root:root 0600) and reaches only the worker process via systemd
# LoadCredential=. Never put a secret in this file.

# The Railway API's public HTTPS origin (the control plane the worker pulls from).
GWA_API_BASE_URL=https://<railway-api-public-domain>

# A non-secret name that appears in logs.
GWA_WORKER_ID=gwa-worker-1

# Trusted, read-only dependency preparation (inside StateDirectory).
GWA_DEPENDENCY_ROOT=/var/lib/gwa-worker/deps
